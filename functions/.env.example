# Cloud Functions runtime config.
#
#   cp functions/.env.example functions/.env
#
# Firebase reads this at deploy time and exposes the values as process.env.
# Nothing here ever reaches a browser.
#
# For deployed environments the credentials below belong in Secret Manager,
# not in a file:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set HL_CLIENT_SECRET
#
# Anything left in this file is deployed as a plain environment variable, so
# secrets must not stay here. Local values go in functions/.secret.local.

# Firestore database id. `getFirestore()` with no argument connects to
# `(default)`, which is not where this project keeps its data. Must match
# `database` in firebase.json and VITE_FIREBASE_DATABASE_ID in frontend/.env.
FIRESTORE_DATABASE_ID=

# Anthropic API key — https://console.anthropic.com. Used from Slice 5.
#
# Lives in Secret Manager, not here. Everything in this file is uploaded as a
# plain environment variable on the Cloud Run service and is readable by anyone
# with Viewer on the project:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#
# For emulator runs put the value in functions/.secret.local (gitignored).
# The name is left here so the file still documents what the runtime expects.
ANTHROPIC_API_KEY=

# HighLevel marketplace app credentials. Used from Slice 2.
# Marketplace → My Apps → your app → Advanced Settings → Secrets → Client Keys.
# NOTE: the client secret is displayed exactly once at creation.
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# Must match the redirect URL registered on the marketplace app, byte for byte:
#   https://<your-project>.web.app/api/oauth/callback
#
# NOTE: HighLevel rejects a redirect URL containing the string "highlevel".
# That is why this project's id is `hl-genesis-app` and not something derived
# from the product name — the constraint is on the URL, so it decided the
# project id, which is immutable. Pick a compliant id before creating the
# Firebase project, not after.
HL_REDIRECT_URI=

# Key the OAuth `state` parameter is encrypted under. Used from Slice 2.
#
# The state carries the Firebase uid across an unauthenticated callback, so it
# is sealed with AES-256-GCM under a key derived from this value by HKDF —
# encrypted rather than merely signed, because a signed payload is readable by
# whoever holds it and this one travels in a URL to HighLevel, into browser
# history and their request logs.
#
# Generate a fresh one, never reuse another secret for it:
#
#   openssl rand -base64 32
#
# Lives in Secret Manager for deployed environments:
#
#   firebase functions:secrets:set OAUTH_STATE_SECRET
#
# Rotating it invalidates every connect started in the previous 5 minutes —
# those users see "that connection link expired" and simply click again.
OAUTH_STATE_SECRET=

# HighLevel API hosts. Blank uses the real ones; the emulator points these at a
# local fake so the e2e suite can walk the whole OAuth loop offline.
HL_AUTHORIZE_BASE=
HL_TOKEN_BASE=

# Comma-separated origins allowed to call /api from a browser. Blank falls back
# to local dev origins only. These endpoints are same-origin in production via
# the Hosting rewrite, so this is defence in depth — but left unrestricted the
# CORS layer reflects whatever Origin it is given.
ALLOWED_ORIGINS=

# No mail provider. Firebase Authentication sends the verification and
# password-reset emails itself, from noreply@<project>.firebaseapp.com. The
# templates — sender name, subject, body, and the action URL — are edited in the
# Firebase console, not here.
