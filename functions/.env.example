# Cloud Functions runtime config.
#
#   cp functions/.env.example functions/.env
#
# Firebase reads this at deploy time and exposes the values as process.env.
# Nothing here ever reaches a browser.
#
# For deployed environments the credentials below belong in Secret Manager,
# not in a file:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set HL_CLIENT_SECRET
#
# Anything left in this file is deployed as a plain environment variable, so
# secrets must not stay here. Local values go in functions/.secret.local.

# Firestore database id. `getFirestore()` with no argument connects to
# `(default)`, which is not where this project keeps its data. Must match
# `database` in firebase.json. Server-side only: the frontend has no Firestore
# handle at all, because every read and write goes through a Cloud Function
# route.
FIRESTORE_DATABASE_ID=

# Anthropic API key — https://console.anthropic.com.
#
# LEAVE THIS BLANK. It is declared with `defineSecret` and bound to the
# `generate` function alone, so it comes from Secret Manager at runtime and never
# from this file. Everything here is uploaded as a plain environment variable on
# the Cloud Run service and is readable by anyone with Viewer on the project.
#
# For a deployed environment:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#
# For emulator runs the value comes from functions/.secret.local, which is
# gitignored and created from functions/.secret.local.example by
# `scripts/ensure-secret-local.mjs` on `npm run dev` and on the test scripts. The
# placeholder it writes is never used: under the emulator the LLM client takes
# the fake path and never constructs an SDK client. Put a real key there only to
# check a local build against the live API by hand.
#
# The name is left here so this file still documents what the runtime expects.
ANTHROPIC_API_KEY=

# HighLevel marketplace app credentials. Used from Slice 2.
# Marketplace → My Apps → your app → Advanced Settings → Secrets → Client Keys.
# NOTE: the client secret is displayed exactly once at creation.
# LEAVE BLANK — a `defineSecret` bound to `api`. Not because it is a credential
# (it travels in every authorize URL) but because functions/.env has to be
# synthesised by the deploy, and on a public repository that published it.
#   firebase functions:secrets:set HL_CLIENT_ID
HL_CLIENT_ID=

# The client secret. LEAVE THIS BLANK.
#
# Declared with `defineSecret` in functions/src/hl/config.ts and bound to the
# `api` function alone, so it comes from Secret Manager at runtime and never from
# this file. It is half of the marketplace app's credentials and HighLevel shows
# it exactly once at creation — a leak is a re-issue, not a rotation.
#
#   firebase functions:secrets:set HL_CLIENT_SECRET
#
# For emulator runs the value comes from functions/.env.local, which is committed
# and holds a fake: `SecretParam.value()` reads process.env, which the emulator
# populates from that file.
HL_CLIENT_SECRET=

# Must match the redirect URL registered on the marketplace app, byte for byte:
#   https://<your-project>.web.app/api/oauth/callback
#
# NOTE: HighLevel rejects a redirect URL containing the string "highlevel".
# That is why this project's id is `hl-genesis-app` and not something derived
# from the product name — the constraint is on the URL, so it decided the
# project id, which is immutable. Pick a compliant id before creating the
# Firebase project, not after.
# LEAVE BLANK — a `defineSecret` bound to `api`, for HL_CLIENT_ID's reason.
#   firebase functions:secrets:set HL_REDIRECT_URI
HL_REDIRECT_URI=

# Key the OAuth `state` parameter is encrypted under. Used from Slice 2.
#
# The state carries the Firebase uid across an unauthenticated callback, so it
# is sealed with AES-256-GCM under a key derived from this value by HKDF —
# encrypted rather than merely signed, because a signed payload is readable by
# whoever holds it and this one travels in a URL to HighLevel, into browser
# history and their request logs.
#
# Generate a fresh one, never reuse another secret for it:
#
#   openssl rand -base64 32
#
# LEAVE THIS BLANK. Declared with `defineSecret` in functions/src/hl/state.ts
# and bound to the `api` function alone, so it comes from Secret Manager at
# runtime and never from this file — everything left here is uploaded as a plain
# Cloud Run environment variable, readable by anyone with Viewer on the project.
# Disclosure of this one value defeats the whole mechanism: whoever holds it can
# mint a state naming any uid and have the callback attach a HighLevel location
# to that account.
#
#   firebase functions:secrets:set OAUTH_STATE_SECRET
#
# For emulator runs the value comes from functions/.env.local, which is committed
# and holds a fake.
#
# Rotating it invalidates every connect started in the previous 5 minutes —
# those users see "that connection link expired" and simply click again.
OAUTH_STATE_SECRET=

# HighLevel hosts. Blank uses the real ones; the emulator points both at a local
# fake so the e2e suite can walk the whole OAuth loop offline.
#
#   HL_AUTHORIZE_BASE  the marketplace, which serves /oauth/chooselocation
#   HL_API_BASE        services.leadconnectorhq.com, which serves BOTH
#                      /oauth/token and /locations/{id} — one host, so one var,
#                      because two would have to be kept equal by hand.
HL_AUTHORIZE_BASE=
HL_API_BASE=

# Comma-separated origins allowed to call /api from a browser. Blank falls back
# to local dev origins only. These endpoints are same-origin in production via
# the Hosting rewrite, so this is defence in depth — but left unrestricted the
# CORS layer reflects whatever Origin it is given.
# LEAVE BLANK — a `defineSecret` bound to BOTH `api` and `generate`, since
# generate.ts imports originAllowlist from api. For HL_CLIENT_ID's reason.
#   firebase functions:secrets:set ALLOWED_ORIGINS
ALLOWED_ORIGINS=

# No mail provider. Firebase Authentication sends the verification and
# password-reset emails itself, from noreply@<project>.firebaseapp.com. The
# templates — sender name, subject, body, and the action URL — are edited in the
# Firebase console, not here.

# Whether the proxy may reach POST /conversations/messages. Used from Slice 8.
#
# LEAVE THIS BLANK, everywhere, including the test suites.
#
# That route sends a real SMS or email: it costs money and it reaches a real
# person. In the sandbox it may also fail for want of a provisioned number,
# which reads like our bug rather than a missing phone line. The row is on the
# allowlist so the surface is a deliberately safed one rather than an
# unimplemented one — with the flag unset it answers `403 route_disabled`, which
# is a different code from `route_not_allowed` precisely so the two can be told
# apart.
#
# Only the exact string `true` enables it. Anything else — `1`, `yes`, `TRUE` —
# leaves it off, so a stray value cannot switch on a route that spends money.
HL_ALLOW_MESSAGE_SEND=
