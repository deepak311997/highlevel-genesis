# Local values for secrets that live in Secret Manager when deployed.
#
# Committed, and its copy `functions/.secret.local` is gitignored. The functions
# emulator reads the copy to resolve a declared `defineSecret`; without it, the
# first /generate invocation logs
#
#   ERROR … Unable to access secret environment variables
#
# because it falls through to Secret Manager on a demo project with no
# credentials. `scripts/ensure-secret-local.mjs` makes the copy on `npm run dev`
# and on every test script, and never overwrites one that exists.
#
# The placeholder below is never used: under the emulator the LLM client takes
# the fake path (functions/src/llm/fake.ts) and never constructs an SDK client.
#
# To check a build against the real API by hand, put a real key in
# functions/.secret.local — never here.
ANTHROPIC_API_KEY=emulator-placeholder-never-used

# The other two declared secrets, both bound to the `api` function.
#
# Placeholders, and nothing checks them: the fake HighLevel server the emulator
# runs never validates a client secret, and the OAuth `state` cipher only needs a
# value that is stable for the length of a run — it seals and opens under the
# same key either way.
#
# They are named here so the emulator resolves them from this file instead of
# falling through to Secret Manager, which on a demo project with no credentials
# logs the red error above. Real values belong in Secret Manager for a deployed
# environment and in functions/.secret.local for a hand-check against live
# HighLevel — never here.
HL_CLIENT_SECRET=emulator-placeholder-never-validated
OAUTH_STATE_SECRET=emulator-placeholder-stable-within-a-run

# The four that are configuration rather than credentials, and are declared
# secrets anyway — see functions/src/hl/config.ts and functions/src/api/index.ts
# for why. Under the emulator they are resolved from here.
#
# These values MUST match functions/.env.local, which is committed and sets the
# same names. Both end up in process.env and the last write wins, so a mismatch
# would mean the fake OAuth flow authorizing against one redirect URI and
# exchanging against another — a failure that looks like a HighLevel bug.
HL_CLIENT_ID=emulator-client-id
HL_VERSION_ID=emulator-version-id
HL_REDIRECT_URI=http://localhost:5173/api/oauth/callback
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
