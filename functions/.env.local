# Emulator-only configuration.
#
# **Every value here is fake, and this file is committed on purpose.**
#
# Firebase reads `.env.local` only for the local emulator suite, never deploys
# it, and lets it take precedence over `.env`. That precedence is the point:
# `functions/.env` holds the real project's values, including a redirect URI
# pointing at the deployed site — so without this file the local OAuth flow
# sends the browser to production, where the callback does not exist yet and
# answers 404. It looks like a broken app and is a configuration bug.
#
# `.gitignore` carries a deliberate exception for this path. Anything secret
# belongs in `.env` or Secret Manager, never here.

# Matches `database` in firebase.json.
FIRESTORE_DATABASE_ID=hl-genesis

# Fake, and it must be: a state sealed with the production key would be
# openable by the production callback.
OAUTH_STATE_SECRET=emulator-only-state-secret-not-used-anywhere-real

# The dev server's origin, for the CORS allowlist.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================================
# MODE A — stubbed HighLevel  (the default; leave this block uncommented)
# ============================================================================
# The stand-in HighLevel is served by the `api` function itself and mounted only
# under the emulator, so the whole OAuth loop runs offline: no network, no
# sandbox, no expiring authorization codes. This is also the mode every
# automated test runs in — `CLAUDE.md` requires HighLevel to be stubbed in CI.

HL_AUTHORIZE_BASE=http://127.0.0.1:5001/demo-genesis/asia-south1/api/__fake-hl
HL_API_BASE=http://127.0.0.1:5001/demo-genesis/asia-south1/api/__fake-hl
HL_CLIENT_ID=emulator-client-id
HL_CLIENT_SECRET=emulator-client-secret
HL_VERSION_ID=emulator-version-id

# Points at the Vite dev server, so the callback stays same-origin with the SPA:
# Vite proxies `/api` to the functions emulator, the function answers with a
# *relative* redirect, and the browser resolves it against the app.
HL_REDIRECT_URI=http://localhost:5173/api/oauth/callback


# ============================================================================
# MODE B — the real HighLevel, through an HTTPS tunnel
# ============================================================================
# For checking the integration against live HighLevel *before* deploying.
# Comment out MODE A above and uncomment this block.
#
# HighLevel requires an HTTPS redirect URI and matches it byte for byte, which
# is why a tunnel is needed at all — `http://localhost` is not acceptable to it.
#
# Setup, once:
#   1. Run a tunnel to the Vite dev server:   ngrok http 5173
#   2. Register the tunnel's callback on the marketplace app, under
#      Advanced Settings -> Auth -> Redirect URL:
#          https://<your-tunnel>/api/oauth/callback
#   3. Put the same string in HL_REDIRECT_URI below, byte for byte.
#   4. Copy the real client id, secret and version id from `functions/.env`.
#   5. Open the app through the tunnel URL, not through localhost — the
#      callback's redirect is relative, so it resolves against whichever origin
#      the browser is on.
#
# Caveats worth knowing before you switch:
#   - Authorization codes are single-use and short-lived. A failed attempt needs
#     a fresh trip through the consent screen.
#   - If HighLevel allows only one redirect URL per app, registering the tunnel
#     replaces the deployed one. Put it back before shipping.
#   - Free tunnels can hand out a new hostname on restart. If yours does, steps
#     2 and 3 have to be repeated each time — which is the main reason MODE A is
#     the default rather than this.
#   - Tests always run MODE A regardless. Switching here is for manual checks.
#
# HL_AUTHORIZE_BASE=https://marketplace.gohighlevel.com
# HL_API_BASE=https://services.leadconnectorhq.com
# HL_CLIENT_ID=<copy from functions/.env>
# HL_CLIENT_SECRET=<copy from functions/.env>
# HL_VERSION_ID=<copy from functions/.env>
# HL_REDIRECT_URI=https://<your-tunnel>/api/oauth/callback
# ALLOWED_ORIGINS=https://<your-tunnel>
