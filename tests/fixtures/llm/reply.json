      "text": "\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "<genesis:file path=\"styles.css\">\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "body {\n  font-family: system-ui, sans-serif;\n  margin: 2rem;\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "}\n\n#rows li {\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "  padding: 0.5rem 0;\n}\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "</genesis:file>\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "<genesis:file path=\"app.js\">\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "const rows = document.getElementById('rows')\nconst q = document.getElementById('q')\n\n// Your calendar's id - Settings > Calendars in the CRM.\nconst calendarId = 'CALENDAR_ID'\n\nlet contacts = []\nlet events = []\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "\nasync function load() {\n  try {\n    const page = await hl('POST', '/contacts/search', { pageLimit: 20 })\n    contacts = page.contacts || []\n\n    const startTime = Date.now()\n    const endTime = startTime + 7 * 24 * 60 * 60 * 1000\n    const upcoming = await hl('GET', '/calendars/events', { startTime, endTime, calendarId })\n    events = upcoming.events || []\n\n    render()\n  } catch (err) {\n    rows.textContent = err.message\n  }\n}\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "\nfunction render() {\n  const term = q.value.trim().toLowerCase()\n  rows.innerHTML = ''\n  for (const contact of contacts) {\n    if (term && !contact.contactName.toLowerCase().includes(term)) continue\n    const li = document.createElement('li')\n    li.textContent = contact.contactName + ' - ' + contact.email\n    rows.append(li)\n  }\n  for (const event of events) {\n    const li = document.createElement('li')\n    li.textContent = event.title + ' - ' + new Date(event.startTime).toLocaleString()\n    rows.append(li)\n  }\n}\n\nq.addEventListener('input', render)\nload()\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "</genesis:file>\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "\nOpen index.html to see it."
    }
  },
