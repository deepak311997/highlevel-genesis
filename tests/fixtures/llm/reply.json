      "text": "Clicking a row opens that contact's details. "
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "Every value is read from your CRM account."
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "\n\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "<genesis:file path=\"index.html\">\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Contacts</title>\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <h1>Contacts</h1>\n    <input id=\"q\" placeholder=\"Search\" />\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "    <ul id=\"rows\"></ul>\n    <script src=\"app.js\"></script>\n  </body>\n</html>\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
      "type": "text_delta",
      "text": "</genesis:file>\n"
    }
  },
  {
    "type": "content_block_delta",
    "index": 1,
    "delta": {
