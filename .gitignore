node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/lib/

# Secrets — never commit.
# Broad glob on purpose: .env.backup, .env.prod, .env.save and friends all
# carry the same secrets as .env, and a narrow list misses whichever variant
# someone creates next.
.env
.env.*
!.env.example

# Emulator-only, and committed deliberately. Firebase reads `.env.local` for the
# local emulator suite alone and never deploys it, so it is the one place a
# fake credential belongs. Committing it is what makes `npm run dev` and the
# test suites work from a fresh clone — without it the local OAuth flow inherits
# `.env`'s production redirect URI and completes on the deployed site.
# It holds nothing secret; anything that is belongs in .env or Secret Manager.
!functions/.env.local
*.pem
service-account*.json

# Local values for secrets that live in Secret Manager when deployed. Not
# matched by the .env.* glob above, so it needs its own line.
.secret.local
**/.secret.local

# Test output
playwright-report/
test-results/
.nyc_output/

# Editors / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Assignment brief — kept local, not published to the public repo
GENESIS_ASSIGNMENT_V2.pdf

# Emulator state, persisted between `npm run dev` runs so a local session
# survives a restart. Throwaway by definition — never commit it.
.emulator-data/

# Generated by scripts/test-emulator-config.mjs on every test run.
firebase.test.json
