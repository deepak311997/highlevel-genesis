# Genesis — environment variables, all of them.
#
# This file is a MAP, not a file you copy. Genesis is a monorepo and the two
# packages are configured separately, because they have opposite disclosure
# properties: everything in frontend/ is compiled into the bundle and is public,
# and everything in functions/ is server-side and must never reach a browser.
# One shared .env would put those two classes of value in the same place, which
# is how a secret ends up in a bundle.
#
#   cp frontend/.env.example  frontend/.env
#   cp functions/.env.example functions/.env
#
# Each of those files documents its own variables in full. This one exists so
# there is a single place to see everything the project needs, and because the
# assignment's repo layout calls for a .env.example at the root.
#
# NEVER commit a filled-in .env. .gitignore uses a broad `.env.*` glob for that
# reason, with an exception for the .example files.

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env — PUBLIC. Compiled into the bundle, readable by any visitor.
# Access is controlled by Firestore security rules, not by hiding these.
# ─────────────────────────────────────────────────────────────────────────────

# All six come from: firebase apps:sdkconfig WEB --project <your-project-id>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Where the dev server proxies /api and /generate. Blank derives it
# from the project id and region.
VITE_FUNCTIONS_BASE_URL=

# reCAPTCHA v3 SITE key, for App Check. The site key is public; the reCAPTCHA
# SECRET key is not and belongs nowhere near this section.
VITE_GOOGLE_RECAPTCHA_V3_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# functions/.env — SERVER-SIDE. Nothing here ever reaches a browser.
#
# For deployed environments the credentials below belong in Secret Manager, not
# in a file — anything left in functions/.env is uploaded as a plain environment
# variable on the Cloud Run service and is readable by anyone with Viewer:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set HL_CLIENT_SECRET
#   firebase functions:secrets:set OAUTH_STATE_SECRET
#
# For emulator runs, local values go in functions/.secret.local (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# The NAMED Firestore database this project keeps its data in — not
# `(default)`. Must match `database` in firebase.json. Server-side only: the
# frontend has no Firestore handle at all, because every read and write goes
# through a Cloud Function route.
FIRESTORE_DATABASE_ID=

# Anthropic API key — https://console.anthropic.com. Used from Slice 5.
# SECRET MANAGER ONLY.
ANTHROPIC_API_KEY=

# HighLevel marketplace app credentials. Used from Slice 2.
# Marketplace -> My Apps -> your app -> Advanced Settings -> Secrets.
# NOTE: the client secret is displayed exactly once, at creation.
# SECRET MANAGER ONLY — bound to the `api` function.
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# Key the OAuth `state` parameter is encrypted under. Used from Slice 2.
# SECRET MANAGER ONLY — bound to the `api` function. `openssl rand -base64 32`.
OAUTH_STATE_SECRET=

# Must match the redirect URL registered on the marketplace app, byte for byte:
#   https://<your-project>.web.app/api/oauth/callback
HL_REDIRECT_URI=

# Comma-separated origins allowed to call /api from a browser. Blank falls back
# to local dev origins only.
ALLOWED_ORIGINS=
