# =============================================================================
# Genesis — environment variables
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Frontend values are compiled into the bundle and are public by design —
# Firebase web config is not a secret. Everything under "server-side" IS a
# secret and must be set with `firebase functions:secrets:set NAME` before
# deploying, never placed in .env for production.
# =============================================================================

# --- Frontend (Vite) ---------------------------------------------------------
# From Firebase console → Project settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SPA at the local emulators instead of production Firebase.
# Set to "false" (or remove) for deployed builds.
VITE_USE_EMULATORS=true

# Base URL for Cloud Functions calls. LEAVE THIS EMPTY for normal use.
#
# The SPA calls same-origin relative paths (/api/**). In development the Vite
# dev-server proxy forwards them to the functions emulator; in production the
# Firebase Hosting rewrite forwards them to the function. Neither needs a URL.
#
# Set this only to point a local SPA at a deployed backend.
VITE_FUNCTIONS_BASE_URL=

# --- Server-side secrets -----------------------------------------------------
# Local emulator runs read these from .env. For deploys use:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set HL_CLIENT_ID
#   firebase functions:secrets:set HL_CLIENT_SECRET

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=

# HighLevel marketplace app credentials.
# Marketplace → My Apps → your app → Advanced Settings → Secrets → Client Keys.
# NOTE: the client secret is displayed exactly once at creation.
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# Must match the redirect URL registered on the marketplace app, byte for byte.
# Local:     http://127.0.0.1:5000/api/oauth/callback
# Deployed:  https://<your-project>.web.app/api/oauth/callback
HL_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/callback
