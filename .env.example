# Genesis — environment variables, all of them.
#
# This file is a MAP, not a file you copy. Genesis is a monorepo and the two
# packages are configured separately, because they have opposite disclosure
# properties: everything in frontend/ is compiled into the bundle and is public,
# and everything in functions/ is server-side and must never reach a browser.
# One shared .env would put those two classes of value in the same place, which
# is how a secret ends up in a bundle.
#
#   cp frontend/.env.example  frontend/.env
#   cp functions/.env.example functions/.env
#
# Each of those files documents its own variables in full. This one exists so
# there is a single place to see everything the project needs, and because the
# assignment's repo layout calls for a .env.example at the root.
#
# PARITY IS CHECKED — scripts/check-secrets.mjs fails the suite if a variable is
# documented in a package file and not here, which is how this file drifted four
# variables behind once already. The check is ONE-DIRECTIONAL: the root may carry
# more than the packages do, and it does — the operator-script variables at the
# bottom are read by scripts/, by nothing that deploys, so they have no package
# file to live in.
#
# NEVER commit a filled-in .env. .gitignore uses a broad `.env.*` glob for that
# reason, with an exception for the .example files.

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env — PUBLIC. Compiled into the bundle, readable by any visitor.
# Access is controlled by Firestore security rules, not by hiding these.
# ─────────────────────────────────────────────────────────────────────────────

# From: firebase apps:sdkconfig WEB --project <your-project-id>, which prints
# six. The other two — storageBucket and messagingSenderId — configure SDKs this
# app does not import, so they are not carried.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. Where the dev server proxies /api and /generate. Blank derives it
# from the project id and region.
VITE_FUNCTIONS_BASE_URL=

# The generate function's OWN url, which takes the streaming turn off the Hosting
# rewrite. Hosting's CDN buffers a rewritten response to completion and drops the
# origin at 60 seconds, so a two-minute generation reached the browser as a 502
# while the function finished and stored the reply, and nothing ever streamed.
# Blank is same-origin — right for development and the emulator, the bug above in
# a production build.
VITE_GENERATE_URL=

# reCAPTCHA v3 SITE key, for App Check. The site key is public; the reCAPTCHA
# SECRET key is not and belongs nowhere near this section.
VITE_GOOGLE_RECAPTCHA_V3_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# functions/.env — SERVER-SIDE. Nothing here ever reaches a browser.
#
# For deployed environments the credentials below belong in Secret Manager, not
# in a file — anything left in functions/.env is uploaded as a plain environment
# variable on the Cloud Run service and is readable by anyone with Viewer:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set HL_CLIENT_SECRET
#   firebase functions:secrets:set OAUTH_STATE_SECRET
#
# For emulator runs, local values go in functions/.secret.local (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# The NAMED Firestore database this project keeps its data in — not
# `(default)`. Must match `database` in firebase.json. Server-side only: the
# frontend has no Firestore handle at all, because every read and write goes
# through a Cloud Function route.
FIRESTORE_DATABASE_ID=

# Anthropic API key — https://console.anthropic.com. Used from Slice 5.
# SECRET MANAGER ONLY.
ANTHROPIC_API_KEY=

# HighLevel marketplace app credentials. Used from Slice 2.
# Marketplace -> My Apps -> your app -> Advanced Settings -> Secrets.
# NOTE: the client secret is displayed exactly once, at creation.
# SECRET MANAGER ONLY — bound to the `api` function.
HL_CLIENT_ID=
HL_CLIENT_SECRET=

# The app VERSION id, required by the v2 authorize endpoint. Read it off the
# portal's own install link; omit it and HighLevel answers "No integration found
# with the id: <app id>", which reads like a bad client id and is not.
# SECRET MANAGER ONLY — bound to the `api` function.
HL_VERSION_ID=

# Key the OAuth `state` parameter is encrypted under. Used from Slice 2.
# SECRET MANAGER ONLY — bound to the `api` function. `openssl rand -base64 32`.
OAUTH_STATE_SECRET=
# The key the stored HighLevel tokens are sealed under, AES-256-GCM. Firestore
# encrypts at rest already, which protects the disks; this protects against
# anything holding a Firestore READ — a leaked viewer key, an export in a bucket.
# Its own secret rather than OAUTH_STATE_SECRET: rotating one should not
# invalidate every stored connection.
#
#   firebase functions:secrets:set HL_TOKEN_SECRET
HL_TOKEN_SECRET=


# Must match the redirect URL registered on the marketplace app, byte for byte:
#   https://<your-project>.web.app/api/oauth/callback
HL_REDIRECT_URI=

# HighLevel hosts. Blank uses the real ones; the emulator points both at a local
# fake so the e2e suite can walk the whole OAuth loop offline. HL_API_BASE serves
# both /oauth/token and /locations/{id} — one host, so one variable.
HL_AUTHORIZE_BASE=
HL_API_BASE=

# Comma-separated origins allowed to call /api from a browser. Blank falls back
# to local dev origins only.
ALLOWED_ORIGINS=

# Whether the proxy may reach POST /conversations/messages, which sends a real
# SMS or email. LEAVE BLANK everywhere, test suites included; only the exact
# string `true` enables it, so a stray value cannot switch on a route that spends
# money. Unset, that route answers 403 route_disabled.
HL_ALLOW_MESSAGE_SEND=

# ─────────────────────────────────────────────────────────────────────────────
# Operator scripts — read by scripts/, deployed nowhere.
#
# These configure a chore run by hand from a clone. No deployed code reads them,
# so they appear in no package .env.example and belong in neither .env file; the
# parity check is one-directional for exactly this reason.
# ─────────────────────────────────────────────────────────────────────────────

# Read by scripts/seed-sandbox.mjs, which fills a HighLevel sandbox with demo
# data by calling HighLevel directly — not through the Genesis proxy, and never
# touching Firestore.
#
#   HL_SEED_TOKEN        a HighLevel Private Integration Token, or an OAuth
#                        access token; the API is identical either way
#   HL_SEED_LOCATION_ID  the sandbox location the contacts and appointments
#                        are created in
#
# Pass them on the command line rather than leaving them in a file, and dry-run
# first:
#
#   HL_SEED_TOKEN=… HL_SEED_LOCATION_ID=… node scripts/seed-sandbox.mjs --dry-run
HL_SEED_TOKEN=
HL_SEED_LOCATION_ID=
