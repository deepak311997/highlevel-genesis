# Frontend runtime config.
#
#   cp frontend/.env.example frontend/.env
#
# Vite reads this file natively — it sits beside vite.config.ts.
#
# Every value here is compiled into the bundle and is PUBLIC by design: it
# identifies the Firebase project, it does not authorise anything. Access is
# controlled by Firestore security rules. Never put a secret in this file —
# server-side credentials belong in functions/.env.

# From `firebase apps:sdkconfig WEB --project <your-project-id>`, which prints
# six values. Only these four are here: nothing this app loads reads
# `storageBucket` or `messagingSenderId` — they configure the Storage and
# Messaging SDKs, and it imports neither. See functions/../src/lib/firebase.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. Where the dev server proxies /api and /generate. Leave blank and it
# is derived from the project id and region:
#   https://<region>-<project-id>.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=

# reCAPTCHA v3 SITE key, for App Check. Firebase Console -> App Check -> Apps.
#
# Public by design: everything prefixed VITE_ is compiled into the bundle, so
# this value is readable by any visitor. That is fine for a site key and fatal
# for a secret key — the reCAPTCHA secret belongs in functions/, never here.
VITE_GOOGLE_RECAPTCHA_V3_KEY=
