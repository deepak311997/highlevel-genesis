{
  "firestore": {
    "database": "hl-genesis",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "*.test.ts"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-south1"
        }
      },
      {
        "source": "/generate",
        "function": {
          "functionId": "generate",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/generate",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-transform"
          }
        ]
      }
    ]
  },
  "emulators": {
    "_comment": "Test-only. Dev and production talk to real Firebase; these exist so the rules, integration and e2e suites run hermetically, offline, against a throwaway project id \u2014 never the live project. The frontend only ever connects to them under `vite --mode test`, so a production bundle cannot reach them.",
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
