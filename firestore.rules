rules_version = '2';

// Genesis security rules.
//
// Principle: deny by default. Every collection is owner-scoped, and the
// OAuth token document is unreachable from any client — only the Admin SDK
// inside a Cloud Function may touch it.
//
// Rules are additive (OR'd), so the absence of an `allow` is the denial.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email verification, enforced here rather than only in the router.
    //
    // A route guard stops a browser; it does not stop anyone holding a valid
    // token. Reading the claim here is what makes an unverified account inert
    // — which matters most for a *pre-hijacked* account, one an attacker
    // registered at someone else's address. Until the real owner verifies, it
    // can reach nothing.
    //
    // The claim lives in the ID token and does not refresh on its own, so the
    // client forces getIdToken(true) after verifying. Without that the first
    // read after verification is denied by a stale claim.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // --- user profile -------------------------------------------------
    // Client-written, which is safe only because the document holds nothing
    // privileged. Anything server-derived — connection status, plan, role —
    // belongs in a collection the client cannot write, not here.
    //
    // The rules are an allowlist, not a gate: they pin the exact field set, so
    // a future field cannot arrive without someone revisiting this block.
    match /users/{uid} {
      allow read: if isOwner(uid) && verified();

      allow create: if isOwner(uid) && verified()
        && request.resource.data.keys()
             .hasOnly(['email', 'displayName', 'createdAt', 'updatedAt'])
        // Server clock, not the client's — a backdated createdAt would let a
        // user claim seniority the audit trail does not support.
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid) && verified()
        // email and createdAt are immutable. The address is Firebase Auth's to
        // own; this copy exists for display and must not drift from it.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // Account deletion is not a feature yet. When it is, it belongs in a
      // Cloud Function that also revokes tokens and cascades — not here.
      allow delete: if false;
    }

    // --- HighLevel OAuth tokens ---------------------------------------
    // Deliberately has no allow rule of any kind. The Admin SDK bypasses
    // rules; every client — including the owner — is denied.
    match /hlConnections/{uid} {
      allow read, write: if false;
    }

    // --- auth rate-limit counters -------------------------------------
    // Written only by the auth endpoints. Readable by a client, these would
    // answer "has anyone tried to register this address?" — the enumeration
    // question the uniform registration response exists to refuse.
    match /authThrottle/{key} {
      allow read, write: if false;
    }

    // --- everything else ----------------------------------------------
    // Collections are added slice by slice, each with its own rules and
    // its own denial test. Nothing is reachable until it is.
  }
}
