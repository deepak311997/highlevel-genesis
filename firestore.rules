rules_version = '2';

// Genesis security rules — the backstop, not the enforcement.
//
// Data access is API-only. Every read and write goes through a Cloud Function
// route that verifies the caller's ID token (including `email_verified`),
// parses the payload with Zod, and scopes the query by the uid **from the
// token, never from the request body**. The Admin SDK bypasses this file, so
// that is where the access decisions actually live.
//
// What this file is for: making a mistake in one of those routes a bug rather
// than a breach. Every match block below is a denial, and there is deliberately
// no helper function left — nothing here grants anything, so there is nothing
// to parameterise, and a reader can tell at a glance that no `allow` in this
// file is load-bearing.
//
// Rules are additive (OR'd), so the absence of an `allow` is the denial. The
// explicit `if false` blocks are documentation: they say a collection exists and
// is deliberately unreachable, rather than leaving a reader to wonder whether it
// was forgotten. Every one of them has an L3 test in tests/rules/firestore.spec.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- user profile -------------------------------------------------
    // Written only by PUT /api/users/me and read only by GET /api/users/me.
    // Denied to its owner too: the owner has a route, and a client that can
    // write this document can write fields the route would have refused.
    match /users/{uid} {
      allow read, write: if false;
    }

    // --- HighLevel OAuth tokens ---------------------------------------
    // Holds a live access token and a refresh token, scoped to a whole CRM
    // location. A token readable by the browser is a token readable by anyone
    // who opens devtools, so GET /api/hl/connection returns a redacted
    // projection and this document is reachable from no client at all.
    //
    // From Slice 8 the document has a second writer: the proxy's transactional
    // token refresh rotates `accessToken`, `refreshToken` and `expiresAt`, and
    // sets `needsReconnect: true` on a definitive `invalid_grant` or an upstream
    // 401. So this denial is load-bearing against a document that is actively
    // mutated server-side — in particular against a client clearing
    // `needsReconnect` to make the proxy retry a connection the server has
    // already established is dead. No rule changed for that field, and none
    // should: rules deny the document, whatever it holds.
    match /hlConnections/{uid} {
      allow read, write: if false;
    }

    // --- auth rate-limit counters -------------------------------------
    // Written only by the auth endpoints. Readable by a client, these would
    // answer "has anyone tried to register this address?" — the enumeration
    // question the uniform registration response exists to refuse.
    match /authThrottle/{key} {
      allow read, write: if false;
    }

    // --- projects -----------------------------------------------------
    // A subcollection of the profile, so the owner's uid is part of the
    // document path and the API scopes by the uid from the token alone.
    // Enforcement lives in /api/projects*, not here — PRODUCT_SPEC.md F2.2
    // predates the API-only decision; see the slice PRD's D2.
    //
    // Rules do not cascade into subcollections, so `match /users/{uid}`
    // above says nothing about this path. This block is required, not
    // decorative, even though the default is denial.
    match /users/{uid}/projects/{projectId} {
      allow read, write: if false;
    }

    // --- chat messages ------------------------------------------------
    // A subcollection of a project, so both the owner's uid and the
    // project id are part of the document path and the API scopes by the
    // uid from the token alone. Written only by
    // POST /api/projects/:projectId/messages, which assigns `role` itself
    // — a client that could write here could author an assistant turn,
    // which from Slice 5 on is the LLM's own context.
    match /users/{uid}/projects/{projectId}/messages/{messageId} {
      allow read, write: if false;
    }

    // --- generated files ----------------------------------------------
    // A subcollection of a project, so both the owner's uid and the project
    // id are part of the document path and the API scopes by the uid from
    // the token alone. The document id *is* the filename (D13).
    //
    // Written only by /generate's one batch per turn and by
    // PUT /api/projects/:projectId/files/:path. Read only by the two GETs.
    //
    // These documents *are* the generated application, so a client that could
    // write here could put its own JavaScript into a project and have the
    // preview run it.
    //
    // Rules do not cascade into subcollections, so neither the users block nor
    // the projects block says anything about this path. Required, not
    // decorative.
    match /users/{uid}/projects/{projectId}/files/{fileId} {
      allow read, write: if false;
    }

    // --- everything else ----------------------------------------------
    // Collections are added slice by slice, each with its own denial test.
    // Nothing is reachable until it is.
  }
}
